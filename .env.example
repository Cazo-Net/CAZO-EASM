# Root env file for docker-compose. Copy to .env and fill in.
#   cp .env.example .env

# development | production
ENVIRONMENT=production

# REQUIRED — generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
# Signs the audit log chain. Optional: defaults to a key derived from SECRET_KEY.
# Set it once and never change it, or older audit entries fail the integrity check.
AUDIT_LOG_KEY=

# PostgreSQL credentials (used by the db service and backend/worker)
POSTGRES_USER=easm
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=easm

# Public domain served by nginx (docker-compose.prod.yml)
SERVER_NAME=your-domain.com

# Contact email for Let's Encrypt certificate issuance/renewal
ACME_EMAIL=admin@your-domain.com

# Frontend public URL + allowed CORS origins (JSON array)
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=["https://your-domain.com"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Email delivery (log | smtp | resend)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@your-domain.com

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
