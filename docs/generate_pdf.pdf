#!/usr/bin/env python3
"""Generate CAZO EASM Platform Architecture PDF."""

from fpdf import FPDF
import os

OUTPUT = os.path.join(os.path.dirname(__file__), "CAZO_EASM_Platform_Architecture.pdf")


class CazoPDF(FPDF):
    def header(self):
        self.set_font("Helvetica", "B", 10)
        self.set_text_color(37, 99, 235)
        self.cell(0, 8, "CAZO EASM Platform", align="L")
        self.set_text_color(120, 120, 120)
        self.cell(0, 8, "Architecture Reference v1.0.5", align="R", new_x="LMARGIN", new_y="NEXT")
        self.set_draw_color(37, 99, 235)
        self.set_line_width(0.3)
        self.line(10, self.get_y(), 200, self.get_y())
        self.ln(4)

    def footer(self):
        self.set_y(-15)
        self.set_font("Helvetica", "I", 8)
        self.set_text_color(150, 150, 150)
        self.cell(0, 10, f"Page {self.page_no()}/{{nb}}", align="C")

    def chapter_title(self, title, level=1):
        if level == 1:
            self.set_font("Helvetica", "B", 16)
            self.set_text_color(37, 99, 235)
            self.ln(4)
            self.cell(0, 10, title, new_x="LMARGIN", new_y="NEXT")
            self.set_draw_color(37, 99, 235)
            self.set_line_width(0.5)
            self.line(10, self.get_y(), 80, self.get_y())
            self.ln(4)
        elif level == 2:
            self.set_font("Helvetica", "B", 13)
            self.set_text_color(30, 30, 30)
            self.ln(3)
            self.cell(0, 8, title, new_x="LMARGIN", new_y="NEXT")
            self.ln(2)
        elif level == 3:
            self.set_font("Helvetica", "B", 11)
            self.set_text_color(60, 60, 60)
            self.ln(2)
            self.cell(0, 7, title, new_x="LMARGIN", new_y="NEXT")
            self.ln(1)

    def body_text(self, text):
        self.set_font("Helvetica", "", 10)
        self.set_text_color(40, 40, 40)
        self.multi_cell(0, 5.5, text)
        self.ln(1)

    def bullet(self, text, indent=10):
        self.set_font("Helvetica", "", 10)
        self.set_text_color(40, 40, 40)
        left = self.l_margin
        self.set_x(left + indent)
        self.multi_cell(190 - indent, 5.5, "- " + text)

    def table(self, headers, rows, col_widths=None):
        if col_widths is None:
            w = 190 / len(headers)
            col_widths = [w] * len(headers)
        # Header
        self.set_font("Helvetica", "B", 9)
        self.set_fill_color(37, 99, 235)
        self.set_text_color(255, 255, 255)
        for i, h in enumerate(headers):
            self.cell(col_widths[i], 7, h, border=1, fill=True, align="C")
        self.ln()
        # Rows
        self.set_font("Helvetica", "", 8.5)
        self.set_text_color(40, 40, 40)
        fill = False
        for row in rows:
            if fill:
                self.set_fill_color(240, 244, 255)
            else:
                self.set_fill_color(255, 255, 255)
            max_h = 7
            for i, cell in enumerate(row):
                self.cell(col_widths[i], max_h, str(cell)[:60], border=1, fill=True)
            self.ln()
            fill = not fill
        self.ln(2)


def build_pdf():
    pdf = CazoPDF()
    pdf.alias_nb_pages()
    pdf.set_auto_page_break(auto=True, margin=20)

    # ── COVER PAGE ──
    pdf.add_page()
    pdf.ln(40)
    pdf.set_font("Helvetica", "B", 36)
    pdf.set_text_color(37, 99, 235)
    pdf.cell(0, 15, "CAZO EASM", align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.set_font("Helvetica", "", 18)
    pdf.set_text_color(80, 80, 80)
    pdf.cell(0, 10, "External Attack Surface Management Platform", align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.ln(10)
    pdf.set_draw_color(37, 99, 235)
    pdf.set_line_width(1)
    pdf.line(60, pdf.get_y(), 150, pdf.get_y())
    pdf.ln(10)
    pdf.set_font("Helvetica", "", 12)
    pdf.set_text_color(100, 100, 100)
    pdf.cell(0, 8, "Complete Architecture Reference", align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.cell(0, 8, "Version 1.0.5", align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.cell(0, 8, "July 2026", align="C", new_x="LMARGIN", new_y="NEXT")
    pdf.ln(30)
    pdf.set_font("Helvetica", "I", 10)
    pdf.set_text_color(120, 120, 120)
    pdf.multi_cell(0, 6, "This document provides a comprehensive reference of the CAZO EASM platform architecture, covering backend services, frontend components, database models, scanner engines, API endpoints, security architecture, and deployment infrastructure.", align="C")

    # ── TABLE OF CONTENTS ──
    pdf.add_page()
    pdf.chapter_title("Table of Contents")
    toc = [
        "1. Platform Overview",
        "2. Technology Stack",
        "3. System Architecture",
        "4. Backend Architecture",
        "   4.1 API Routers (34 routers)",
        "   4.2 Services Layer (20+ services)",
        "   4.3 Core Modules",
        "   4.4 Authentication & Security",
        "5. Database Architecture",
        "   5.1 Models (30+ tables)",
        "   5.2 Indexes & Performance",
        "   5.3 Connection Pooling",
        "6. Scanner Architecture",
        "   6.1 V1 Scanner Engine",
        "   6.2 V2 Enterprise Pipeline",
        "   6.3 OSINT Intelligence Engine",
        "7. Frontend Architecture",
        "   7.1 Pages (70+ routes)",
        "   7.2 Components",
        "   7.3 State Management",
        "8. Security Architecture",
        "9. Deployment & Infrastructure",
        "10. Configuration Reference",
    ]
    for item in toc:
        pdf.set_font("Helvetica", "" if item.startswith(" ") else "B", 11)
        pdf.set_text_color(40, 40, 40)
        pdf.cell(0, 7, item, new_x="LMARGIN", new_y="NEXT")

    # ── 1. PLATFORM OVERVIEW ──
    pdf.add_page()
    pdf.chapter_title("1. Platform Overview")
    pdf.body_text(
        "CAZO is a multi-tenant External Attack Surface Management (EASM) platform that discovers, "
        "monitors, and assesses an organization's internet-facing attack surface. It provides continuous "
        "discovery of subdomains, ports, SSL certificates, technologies, DNS records, and vulnerabilities "
        "across an organization's digital assets."
    )
    pdf.chapter_title("Key Capabilities", 2)
    for cap in [
        "Automated subdomain enumeration (crt.sh, DNS brute-force, certificate transparency)",
        "Port scanning with Nmap integration and pure-Python fallback",
        "SSL/TLS certificate monitoring and expiry alerts",
        "Technology fingerprinting (40+ technology signatures)",
        "Vulnerability scanning via Nuclei templates and CVE correlation",
        "OSINT intelligence aggregation from 15+ free sources",
        "Shadow/rogue asset detection with confidence scoring",
        "Real-time change detection and exposure replay timeline",
        "AI-powered security analysis and recommendations",
        "Visual attack surface canvas with drag-and-drop node editor",
        "Multi-tenant organization management with RBAC (6 roles)",
        "Enterprise scan pipeline with 8-stage execution",
        "Scheduled and continuous monitoring",
        "Executive reporting (PDF/CSV/JSON)",
    ]:
        pdf.bullet(cap)

    # ── 2. TECHNOLOGY STACK ──
    pdf.add_page()
    pdf.chapter_title("2. Technology Stack")
    pdf.table(
        ["Layer", "Technology", "Version"],
        [
            ["Backend Framework", "FastAPI (Python)", "0.110+"],
            ["Frontend Framework", "Next.js (React)", "14.1.0"],
            ["Language", "Python / TypeScript", "3.11+ / 5.x"],
            ["Database", "PostgreSQL (prod) / SQLite (dev)", "16"],
            ["Connection Pool", "PgBouncer", "1.21"],
            ["Cache / Broker", "Redis", "7"],
            ["Task Queue", "Celery", "5.x"],
            ["ORM", "SQLAlchemy", "2.x"],
            ["Auth", "JWT (HS256) + bcrypt + WebAuthn", "-"],
            ["MFA", "TOTP (pyotp)", "-"],
            ["CSS", "Tailwind CSS + Shadcn/ui", "3.4"],
            ["Animation", "Framer Motion", "10.x"],
            ["Graph Viz", "ReactFlow + d3-force", "-"],
            ["Charts", "Recharts + ECharts", "-"],
            ["Scanner", "Nmap + Nuclei + custom Python", "-"],
            ["Container", "Docker + Docker Compose", "-"],
            ["Reverse Proxy", "nginx", "-"],
            ["PDF Generation", "ReportLab (backend) / fpdf2", "-"],
        ],
        [50, 80, 60],
    )

    # ── 3. SYSTEM ARCHITECTURE ──
    pdf.add_page()
    pdf.chapter_title("3. System Architecture")
    pdf.body_text(
        "The platform follows a microservices-inspired architecture with clear separation of concerns. "
        "Six Docker services compose the production stack, communicating via HTTP, WebSocket, and a shared PostgreSQL database."
    )
    pdf.chapter_title("Service Topology", 2)
    pdf.table(
        ["Service", "Port", "Role"],
        [
            ["db", "5432", "PostgreSQL 16 with tuned config (512MB shared_buffers, 500 max_connections)"],
            ["pgbouncer", "6432", "Connection pooling (transaction mode, 1000 max client conns)"],
            ["redis", "6379", "Cache, Celery broker, rate limiting (512MB LRU)"],
            ["backend", "8000", "FastAPI REST API (30+ routers, 20+ services)"],
            ["worker", "-", "Celery worker for background tasks (scans, emails, CVE sync)"],
            ["frontend", "3000", "Next.js SSR/CSR application (70+ pages)"],
        ],
        [30, 20, 140],
    )
    pdf.chapter_title("Communication Flow", 2)
    pdf.body_text(
        "1. Frontend (Next.js) -> Backend (FastAPI) via REST API + WebSocket\n"
        "2. Backend -> PostgreSQL via SQLAlchemy (read/write split with optional replica)\n"
        "3. Backend -> Redis for caching and rate limiting\n"
        "4. Backend -> Celery Worker via Redis broker for background tasks\n"
        "5. Scan Engine -> PostgreSQL for job queue (SELECT FOR UPDATE SKIP LOCKED)\n"
        "6. Backend -> External APIs: NVD, CISA KEV, Shodan, crt.sh, Censys (all free tier)"
    )

    # ── 4. BACKEND ARCHITECTURE ──
    pdf.add_page()
    pdf.chapter_title("4. Backend Architecture")
    pdf.body_text(
        "The backend is a FastAPI application organized into routers, services, models, schemas, "
