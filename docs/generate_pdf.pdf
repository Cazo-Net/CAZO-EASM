    )
    components = [
        ["AppShell", "Main layout with Sidebar + TopBar"],
        ["Sidebar", "Collapsible navigation (Overview, Discovery, Tools)"],
        ["TopBar", "Theme toggle, search, quick-create, notifications"],
        ["CommandPalette", "Cmd+K palette (cmdk library)"],
        ["PageHeader", "Consistent page header with breadcrumbs"],
        ["StatCard", "Metric card with icon, value, trend"],
        ["SectionCard", "Container with title, description, actions"],
        ["SeverityPill", "Critical/High/Medium/Low/Info badge"],
        ["NotificationCenter", "Bell icon + dropdown, 30s polling"],
        ["ScanForm", "Domain input + profile selector"],
        ["FindingsTable", "Expandable vulnerability table"],
        ["RiskScoreCard", "SVG circle risk score display"],
        ["ReplayProvider", "Context + useReducer for time-travel state"],
        ["ErrorBoundary", "React error boundary with fallback UI"],
        ["NetworkBackground", "Canvas particle animation background"],
    ]
    pdf.table(["Component", "Purpose"], components, [45, 145])

    pdf.chapter_title("7.3 State Management", 2)
    pdf.body_text(
        "No global store (no Redux/Zustand). All state is local via useState/useReducer.\n"
        "- AuthContext: user, token, login/logout/refresh\n"
        "- ReplayProvider: useReducer for time-travel state\n"
        "- Data fetching: useEffect + Axios (no SWR usage despite dependency)\n"
        "- Polling: NotificationCenter (30s), scan detail (2s during active scan)\n"
        "- WebSocket: Scanner V2 with reconnection + exponential backoff"
    )

    # ── 8. SECURITY ARCHITECTURE ──
    pdf.add_page()
    pdf.chapter_title("8. Security Architecture")
    layers = [
        ["Authentication", "JWT (HS256, 15min access / 7d refresh), bcrypt, WebAuthn"],
        ["Authorization", "RBAC: 6 roles (owner/admin/security_manager/analyst/member/viewer), 26 permissions"],
        ["MFA", "TOTP (pyotp), WebAuthn passkeys, recovery codes"],
        ["SSRF Prevention", "14 blocked networks, write-time + run-time scope validation"],
        ["Rate Limiting", "Redis fixed window or in-memory sliding window, fail-open"],
        ["Brute-force Protection", "5 failed attempts -> 15min lockout"],
        ["Token Rotation", "Refresh token rotation with reuse detection (terminates all sessions)"],
        ["Password Policy", "Min 12 chars, entropy scoring, 90-day expiry, reuse prevention"],
        ["Security Headers", "CSP, HSTS, X-Frame-Options, CORS, COOP, CORP, Permissions-Policy"],
        ["Audit Trail", "Immutable audit events for all mutations"],
        ["API Keys", "SHA-256 hashed, rotation support, expiry"],
        ["Session Management", "Device tracking, IP logging, revocation"],
        ["Scope Enforcement", "Domain/wildcard/IP/CIDR authorization before scanning"],
        ["Email Security", "DMARC/SPF/DKIM analysis, SMTP TLS, CAN-SPAM compliance"],
    ]
    pdf.table(["Layer", "Implementation"], layers, [40, 150])

    # ── 9. DEPLOYMENT ──
    pdf.add_page()
    pdf.chapter_title("9. Deployment & Infrastructure")
    pdf.chapter_title("Docker Compose Services", 2)
    pdf.body_text(
        "Production stack (6 services):\n"
        "1. PostgreSQL 16: tuned (512MB shared_buffers, 500 max_connections, parallel workers)\n"
        "2. PgBouncer: transaction mode, 1000 max client connections, 50 default pool\n"
        "3. Redis 7: 512MB LRU, AOF persistence\n"
        "4. Backend: FastAPI via uvicorn, auto-scaling ready\n"
        "5. Worker: Celery worker, 50 tasks/child recycling\n"
        "6. Frontend: Next.js production build\n"
        "7. nginx (optional): TLS termination, WebSocket proxying, security headers"
    )
    pdf.chapter_title("Celery Beat Schedule", 2)
    pdf.table(
        ["Task", "Schedule", "Purpose"],
        [
            ["check_ssl_expiry", "Daily 06:00 UTC", "SSL certificate expiry alerts"],
            ["send_weekly_digest", "Monday 08:00 UTC", "Weekly security digest email"],
            ["sync_cve_database", "Sunday 03:00 UTC", "NVD CVE database sync"],
        ],
        [55, 45, 90],
    )

    # ── 10. CONFIGURATION ──
    pdf.add_page()
    pdf.chapter_title("10. Configuration Reference")
    pdf.chapter_title("Database Settings", 2)
    config_db = [
        ["DATABASE_URL", "postgresql://...", "Primary database URL"],
        ["DATABASE_READ_URL", "None", "Optional read replica URL"],
        ["DB_POOL_SIZE", "30", "Connection pool size"],
        ["DB_MAX_OVERFLOW", "50", "Max overflow connections"],
        ["DB_POOL_TIMEOUT", "15", "Seconds to wait for connection"],
        ["DB_POOL_RECYCLE", "900", "Connection max age (seconds)"],
        ["DB_POOL_PRE_PING", "true", "Validate connections before use"],
    ]
    pdf.table(["Setting", "Default", "Description"], config_db, [50, 50, 90])

    pdf.chapter_title("Scanner Settings", 2)
    config_scan = [
        ["USE_NMAP", "true", "Use Nmap for port scanning"],
        ["NMAP_TIMEOUT", "300", "Nmap timeout (seconds)"],
        ["NMAP_MAX_CONCURRENCY", "20", "Max concurrent Nmap scans"],
        ["MAX_CONCURRENT_SCANS", "5", "Max concurrent scan jobs"],
        ["SCAN_TIMEOUT", "30", "Per-scanner timeout (seconds)"],
    ]
    pdf.table(["Setting", "Default", "Description"], config_scan, [50, 50, 90])

    pdf.chapter_title("Security Settings", 2)
    config_sec = [
        ["JWT_ACCESS_TOKEN_EXPIRE_MINUTES", "15", "Access token lifetime"],
        ["JWT_REFRESH_TOKEN_EXPIRE_DAYS", "7", "Refresh token lifetime"],
        ["REQUIRE_EXPLICIT_SCOPE", "true", "Require scope to scan"],
        ["REQUIRE_VERIFIED_SCOPE", "false", "Require verified scope"],
        ["RATE_LIMIT_PER_MINUTE", "60", "Global rate limit"],
        ["PASSWORD_EXPIRY_DAYS", "90", "Password expiry period"],
    ]
    pdf.table(["Setting", "Default", "Description"], config_sec, [50, 50, 90])

    # ── OUTPUT ──
    pdf.output(OUTPUT)
    print(f"PDF generated: {OUTPUT}")
    return OUTPUT


if __name__ == "__main__":
    build_pdf()
