        ["Stage 6", "Graph", "Graph-based relationship analysis"],
        ["Stage 7", "Report", "AI analyst, monitoring setup"],
        ["Stage 8", "Cleanup", "Resource cleanup, metrics finalization"],
    ]
    pdf.table(["Step", "Stage", "Description"], v2_stages, [20, 35, 135])

    pdf.chapter_title("6.3 OSINT Intelligence Engine", 2)
    pdf.body_text(
        "The OSINT module aggregates intelligence from 15+ free sources in a 5-phase pipeline "
        "with a 30-second overall timeout. All sources are API-key-free."
    )
    osint_sources = [
        ["hackertarget.com", "Subdomain enumeration, reverse IP"],
        ["certspotter.com", "Certificate transparency logs"],
        ["crt.sh", "Certificate transparency (fallback)"],
        ["otx.alienvault.com", "Passive DNS"],
        ["rapiddns.io", "Subdomain discovery"],
        ["dns.google", "DNS-over-HTTPS"],
        ["shodan.io", "InternetDB port/tech data"],
        ["nvd.nist.gov", "CVE search"],
        ["cisa.gov", "Known Exploited Vulnerabilities"],
        ["ipinfo.io", "IP geolocation"],
        ["abuseipdb.com", "IP abuse reputation"],
        ["greynoise.io", "IP noise classification"],
        ["rdap.org", "WHOIS via RDAP"],
        ["web.archive.org", "Wayback Machine historical subdomains"],
    ]
    pdf.table(["Source", "Data"], osint_sources, [50, 140])

    # ── 7. FRONTEND ARCHITECTURE ──
    pdf.add_page()
    pdf.chapter_title("7. Frontend Architecture")
    pdf.chapter_title("7.1 Pages (70+ routes)", 2)
    pages = [
        ["/dashboard", "Main dashboard with metrics and recent activity"],
        ["/scans", "Scan list with filters and quick-create"],
        ["/scan/[id]", "Scan detail (5 tabs: Subdomains, Ports, SSL, Tech, Vulns)"],
        ["/scan/new", "New scan form with profile selector"],
        ["/assets", "Asset inventory browser"],
        ["/assets/[id]", "Asset 360 view (Overview, Relationships, Timeline, Host Intel)"],
        ["/vulnerabilities", "Vulnerability list with severity filters"],
        ["/canvas", "Visual node editor (ReactFlow, 16 node types)"],
        ["/graph", "Attack surface graph visualization"],
        ["/replay", "Time-travel exposure replay with playback controls"],
        ["/change-feed", "Continuous change stream"],
        ["/shadow-assets", "Shadow asset detection with confidence scoring"],
        ["/search", "Shodan-style search with 16 filter keys"],
        ["/scanner-v2", "Enterprise pipeline with WebSocket streaming"],
        ["/scopes", "Authorization scope management"],
        ["/reports", "Report generation (JSON/CSV/PDF)"],
        ["/settings", "8-tab settings (Profile, Security, Sessions, API Keys, etc.)"],
        ["/settings/organization", "Org management, members, roles"],
        ["/security-center", "Security posture dashboard (0-100 score)"],
        ["/intel", "Intelligence dashboard"],
        ["/dns", "DNS record browser"],
        ["/whois", "WHOIS lookup interface"],
    ]
    pdf.table(["Route", "Description"], pages, [45, 145])

    pdf.chapter_title("7.2 Component Architecture", 2)
    pdf.body_text(
        "The frontend uses a component-based architecture with shared UI primitives "
