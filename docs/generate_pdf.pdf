        ["subdomains", "Discovered subdomains with IPs, alive status"],
        ["ports", "Open ports with service, version, banner detection"],
        ["ssl_certificates", "SSL/TLS certs with validity, chain, SAN data"],
        ["dns_records", "A, AAAA, MX, NS, TXT, CNAME records"],
        ["technologies", "Detected technologies (Wappalyzer-style)"],
        ["vulnerabilities", "CVE findings with severity, status, assignment"],
