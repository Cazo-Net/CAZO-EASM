        ["auth_google.py", "/api/v1/auth", "Google OAuth login/callback"],
        ["scan.py", "/api/v1/scans", "Create/list/delete/rerun scans, dashboard stats"],
        ["scanner_v2.py", "/api/v1/scanner-v2", "Enterprise pipeline, WebSocket streaming, AI analyst"],
        ["assets.py", "/api/v1/assets", "Subdomains, ports, SSL, tech, DNS, WHOIS, graph, inventory"],
        ["asset_360.py", "/api/v1/asset360", "360-degree asset intelligence view"],
        ["vulnerabilities", "-", "Evidence center, finding management"],
        ["organizations.py", "/api/v1/organizations", "Org CRUD, members, roles, stats"],
        ["projects.py", "/api/v1/projects", "Project CRUD"],
        ["users.py", "/api/v1/users", "User profile, avatar, passkey management"],
        ["reports.py", "/api/v1/reports", "Report generation (JSON/CSV/PDF)"],
        ["reports_v2.py", "/api/v1/reports/executive", "Executive summary reports"],
        ["notifications.py", "/api/v1/notifications", "In-app notification CRUD"],
        ["canvas.py", "/api/v1/canvases", "Visual attack surface canvas"],
        ["compare.py", "/api/v1/compare", "Scan-to-scan comparison"],
        ["change_feed.py", "/api/v1/changefeed", "Real-time change feed"],
        ["replay.py", "/api/v1/replay", "Exposure replay timeline"],
        ["shadow.py", "/api/v1/shadow-assets", "Shadow asset detection"],
        ["search.py", "/api/v1/search", "Shodan-style asset search"],
        ["osint.py", "/api/v1/osint", "OSINT intelligence lookups"],
        ["scopes.py", "/api/v1/scopes", "Authorization scope management"],
        ["security.py", "/api/v1/security", "Email change, trusted devices, recovery codes"],
        ["security_center.py", "/api/v1/security-center", "Security posture dashboard"],
        ["admin.py", "/api/v1/admin", "Admin user management"],
        ["sessions.py", "/api/v1/sessions", "Session management"],
        ["passkeys.py", "/api/v1/passkeys", "WebAuthn passkey auth"],
        ["invitations.py", "/api/v1/invitations", "Team invitations"],
        ["tags.py", "/api/v1/tags", "Asset tagging, audit logs, favorites"],
        ["api_keys.py", "/api/v1/api-keys", "API key CRUD"],
        ["api_keys_v2.py", "/api/v1/api-keys/v2", "Enhanced multi-key management"],
        ["collaboration.py", "/api/v1/collaboration", "Asset comments and threads"],
        ["notification_preferences.py", "/api/v1/notification-preferences", "Notification settings"],
    ]
    pdf.table(["File", "Prefix", "Purpose"], routers, [45, 45, 100])

    pdf.add_page()
    pdf.chapter_title("4.2 Services Layer", 2)
    services = [
        ["scan_service.py", "Core scan orchestration, scope enforcement, result storage"],
        ["scan_service_v2.py", "Enterprise v2 scan pipeline execution"],
        ["scan_dispatch.py", "3-tier dispatch: Scan Engine -> Celery -> BackgroundTasks"],
        ["scan_scheduler.py", "In-memory recurring scan scheduler"],
        ["notification_service.py", "Multi-channel dispatch (in-app + email), 24h dedup"],
        ["osint.py", "15-source OSINT aggregation, 5-phase pipeline, 30s timeout"],
        ["osint_advanced.py", "Email security, WAF/CDN, security headers, sensitive paths"],
        ["osint_import.py", "OSINT-to-asset-inventory importer"],
        ["change_detector.py", "Scan diff engine, timeline generation"],
        ["report_service.py", "JSON/CSV/PDF report generation via ReportLab"],
        ["replay_service.py", "Historical exposure timeline and diff"],
        ["scoring.py", "Asset health (0-100) and exposure (0-100) scoring"],
        ["shadow_assets.py", "Shadow detection via IP/cert/ASN correlation"],
        ["password_policy.py", "Password strength validation, entropy scoring"],
        ["audit.py", "Audit trail logging (auth + general events)"],
        ["cve_sync.py", "NVD CVE database synchronization"],
        ["email/sender.py", "3 providers: SMTP, Resend, Log (dev)"],
        ["email/templates.py", "22 HTML email templates with dark mode support"],
    ]
    pdf.table(["Service", "Purpose"], services, [50, 140])

    pdf.add_page()
    pdf.chapter_title("4.3 Core Modules", 2)
    core = [
        ["security.py", "JWT (HS256), bcrypt, TOTP (pyotp), API keys (SHA-256), WebAuthn"],
        ["permissions.py", "RBAC: 6 roles, 26 permissions, custom role support"],
        ["scope.py", "SSRF prevention: domain/wildcard/IP/CIDR, 14 blocked networks"],
        ["cache.py", "Dual-backend: MemoryCache (async TTL) + RedisCache, fail-open"],
        ["rate_limit.py", "Redis (fixed window) or in-memory (sliding window), fail-open"],
        ["logging.py", "Structured JSON (prod) / human-readable (dev)"],
    ]
    pdf.table(["Module", "Purpose"], core, [40, 150])

    pdf.chapter_title("4.4 Authentication Flow", 3)
    pdf.body_text(
        "1. User submits credentials -> auth.py validates (bcrypt check, brute-force lockout)\n"
        "2. On success: creates UserSession, generates access token (15min) + refresh token (7d)\n"
        "3. Frontend stores JWT in localStorage, attaches to every request via Axios interceptor\n"
        "4. On 401: auto-logout and redirect to /login\n"
        "5. Refresh token rotation: on reuse detection, ALL sessions are terminated\n"
        "6. 2FA: TOTP setup -> QR code -> verify code -> enable\n"
        "7. Passkeys: WebAuthn register/assert flows for passwordless auth"
    )

    # ── 5. DATABASE ARCHITECTURE ──
