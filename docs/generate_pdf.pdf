        ["notifications", "ix_notifications_user_read, ix_notifications_user_type"],
        ["authorized_scopes", "ix_scopes_org_type, ix_scopes_org_verified, ix_scopes_value"],
    ]
    pdf.table(["Table", "Composite Indexes"], indexes, [40, 150])

    pdf.chapter_title("5.3 Connection Pooling", 2)
    pdf.body_text(
        "Production pool configuration:\n"
        "- Pool size: 30 (DB_POOL_SIZE)\n"
        "- Max overflow: 50 (DB_MAX_OVERFLOW) -- supports burst to 80 connections\n"
        "- Pool timeout: 15s -- fast failure when pool exhausted\n"
        "- Pool recycle: 900s -- prevents stale connections\n"
        "- Pre-ping: enabled -- validates connections before use\n"
        "- Statement cache: 1000 entries -- avoids re-parsing SQL\n"
        "- Read replica support: DATABASE_READ_URL routes all SELECT to replica\n"
        "- PgBouncer: transaction mode, 1000 max client connections"
    )

    # ── 6. SCANNER ARCHITECTURE ──
    pdf.add_page()
    pdf.chapter_title("6. Scanner Architecture")
    pdf.chapter_title("6.1 V1 Scanner Engine", 2)
    pdf.body_text(
        "The V1 scanner uses a flat registry pattern with decorator-based self-registration. "
        "Scanners run sequentially in 5 stages via ScanRunner."
    )
    v1_scanners = [
        ["SubdomainEnum", "crt.sh + DNS brute (60 prefixes, 15 workers)"],
        ["SubdomainBruteforce", "DNS brute-force with wordlist generation"],
