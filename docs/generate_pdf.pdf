        ["invitations", "Pending team invitations"],
    ]
    pdf.table(["Table", "Description"], models, [50, 140])

    pdf.add_page()
    pdf.chapter_title("5.2 Indexes (1M+ row optimization)", 2)
    pdf.body_text(
        "All high-traffic tables have composite indexes for multi-tenant queries. "
        "Key index patterns:"
    )
    indexes = [
        ["users", "ix_users_org_active, ix_users_org_role, ix_users_email_active"],
        ["scans", "ix_scans_org_status, ix_scans_org_created, ix_scans_active (partial)"],
        ["subdomains", "ix_subdomains_scan_alive, ix_subdomains_hostname"],
        ["vulnerabilities", "ix_vulns_org_status, ix_vulns_org_severity, ix_vulns_fingerprint"],
