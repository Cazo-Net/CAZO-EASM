# CAZO EASM Environment Configuration
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (SQLite for development)
USE_SQLITE=true
SQLITE_URL=sqlite:///./data/easm.db

# Security (auto-generated in dev if empty)
SECRET_KEY=
JWT_SECRET_KEY=

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Redis (optional for dev)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
USE_CELERY=false

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Scope Enforcement
# verified   = targets must match a scope whose ownership is proven by DNS TXT
# registered = targets must match any scope the organization added
# open       = no scope check (private/internal addresses are always blocked)
# Empty = "registered" when ENVIRONMENT=production, "open" otherwise.
# Switch to "verified" once customers have published their TXT records.
SCOPE_ENFORCEMENT=
REQUIRE_EXPLICIT_SCOPE=true
REQUIRE_VERIFIED_SCOPE=false

# Scan execution
# queue  = durable scan_jobs table run by scan workers (production default)
# inline = run inside the API process (development default)
# celery = legacy Celery queue
SCAN_EXECUTION_MODE=
# Also run a scan worker inside the API process. Set to false once a
# dedicated scan-worker service is running.
RUN_EMBEDDED_WORKER=true
SCAN_WORKER_CONCURRENCY=3
SCAN_MAX_RUNNING_PER_ORG=2
SCAN_MAX_ATTEMPTS=2
SCAN_TIMEOUT_QUICK_MINUTES=10
SCAN_TIMEOUT_FULL_MINUTES=45
# Optional tools (only used if the binary is in the image). nuclei runs
# non-intrusive templates only and is off by default.
SCAN_ENABLE_NUCLEI=false
NUCLEI_RATE_LIMIT=10
SCAN_ENABLE_SUBFINDER=true
# Scheduled scans, SSL expiry, weekly digest and CVE sync run in scan workers.
# Set to false only if you run Celery beat instead.
RUN_PERIODIC_TASKS=true

# Caching
CACHE_ENABLED=true

# Email
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@cazo.io
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Google OAuth (get from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=

# AI Provider Configuration
# Multiple API keys supported (comma-separated for rotation)
AI_API_KEYS=

# Single key fallback (used if AI_API_KEYS is empty)
AI_API_KEY=

# AI Base URL (OpenAI-compatible endpoint)
AI_BASE_URL=https://api.openai.com/v1

# AI Model
AI_MODEL=gpt-4o-mini

# AI Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Blockchain Intelligence
# Blockchain Intelligence
# Get your free key at https://etherscan.io/apis — required for live data (falls back to simulated data without one)
ETHERSCAN_API_KEY=

# Neo4j (optional — Phase 2 graph analytics)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Fast Port Scanner (replaces nmap for port discovery)
FAST_SCAN_CONCURRENCY=2000
FAST_SCAN_CONNECT_TIMEOUT=0.5
FAST_SCAN_BANNER_TIMEOUT=1.0

# RDAP (modern WHOIS — fast, structured JSON)
RDAP_BASE_URL=https://rdap.org

# Sentry (error tracking & performance monitoring)
# Get your DSN at https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Upstash Redis (serverless Redis for rate limiting, caching, sessions)
# Create at https://console.upstash.com → Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Upstash QStash (serverless task queue — replaces BackgroundTasks in production)
# Create at https://console.upstash.com → QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Kafka (event streaming — scan events, alerts, audit log)
# Create at https://console.upstash.com → Kafka
UPSTASH_KAFKA_URL=
UPSTASH_KAFKA_USERNAME=
UPSTASH_KAFKA_PASSWORD=

# ── Billing (Stripe) ── see docs/billing.md
# Use TEST keys (sk_test_...). Live keys are refused unless BILLING_ALLOW_LIVE_KEYS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ALLOW_LIVE_KEYS=false
BILLING_CURRENCY=usd
# Optional JSON overrides for prices/limits, e.g. {"business":{"prices":{"myr":450000}}}
BILLING_PLANS_JSON=
BILLING_ENFORCE_LIMITS=true
BILLING_GRACE_DAYS=7
