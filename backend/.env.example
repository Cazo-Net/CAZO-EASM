# ── Application ────────────────────────────────────────────────
APP_NAME=AttackSec
APP_VERSION=1.0.0
# development | production  (production enforces secrets + Postgres)
ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# ── Database ───────────────────────────────────────────────────
# In production set USE_SQLITE=false and provide a PostgreSQL URL.
USE_SQLITE=true
SQLITE_URL=sqlite:///./data/easm.db
DATABASE_URL=postgresql://easm:easm@localhost:5432/easm
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (JSON array or comma-separated) ───────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Redis / Celery ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Scanner settings ───────────────────────────────────────────
SUBFINDER_PATH=subfinder
NMAP_PATH=nmap
NUCLEI_PATH=nuclei
SCAN_TIMEOUT=300
MAX_CONCURRENT_SCANS=5

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── File storage ───────────────────────────────────────────────
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# ── Email (log | smtp | resend) ────────────────────────────────
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Public URL of the frontend (used in email links / invitations)
FRONTEND_URL=http://localhost:3000

# ── AI ─────────────────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
